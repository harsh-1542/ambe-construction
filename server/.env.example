# ── Server ────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# MongoDB — local instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ambe_construction

# Secret used to sign auth tokens. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Days until login expires (token max age)
AUTH_TOKEN_DAYS=30

# Comma-separated list of allowed browser origins (the Vite dev server URL)
CLIENT_URL=http://localhost:5173

# ── Optional: file storage ────────────────────────────────
# If CLOUDINARY_URL is unset, files are stored locally under server/data/uploads
# and served only to the logged-in owner.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Optional: AI assistant (off when unset) ───────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
